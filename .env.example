# Public runtime switches
NEXT_PUBLIC_AUTH_PROVIDER=custom
NEXT_PUBLIC_DATA_SOURCE=remote

# Server-side only (do NOT add NEXT_PUBLIC_ prefix)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
AUTH_SESSION_SECRET=replace-with-at-least-32-char-random-string

# MiniMax server settings (server-side only)
MINIMAX_API_KEY=replace-with-your-minimax-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_TIMEOUT_MS=55000
NEXT_PUBLIC_AUTH_PROVIDER=custom
NEXT_PUBLIC_DATA_SOURCE=remote

# SQLite for local dev (Prisma resolves paths relative to prisma/schema.prisma)
DATABASE_URL=file:./dev.db

# Server-only secret for signing session JWT cookie (>= 32 chars). Never expose via NEXT_PUBLIC_*.
AUTH_SESSION_SECRET=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
